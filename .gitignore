# ==========================================
# 🔑 Environment & API Keys (ความลับและคีย์สำคัญ)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# 🐍 Virtual Environment (สภาพแวดล้อมจำลอง)
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# ⚡ Python Cache & Build Files (ไฟล์คอมไพล์และแคช)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
build/
dist/
*.egg-info/

# ==========================================
# 💻 IDE Config & System Files (ไฟล์ระบบและโปรแกรมเขียนโค้ด)
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# 📝 Log Files (ไฟล์บันทึกการทำงาน)
# ==========================================
*.log

